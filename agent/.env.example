# Copia este archivo como .env y completa los valores.
# AccountID de PSN (base64). Se obtiene con third_party/chiaki-ng/scripts/psn-account-id.py
PSN_ACCOUNT_ID=

# IP local de la PS4 (la muestra el comando "discover")
PS4_HOST=

# --- YouTube Live (solo con "ps4-agent serve --youtube") ---
# Clave de transmisión de YouTube Studio. SECRETA: no la compartas ni la subas a git.
# Sin clave, se graba un archivo de prueba (youtube-test.mkv) en vez de salir en vivo.
YOUTUBE_STREAM_KEY=
# Opcionales:
# FFMPEG_PATH=ffmpeg
# YOUTUBE_ENCODER=auto        (h264_nvenc, h264_amf, h264_qsv o libx264)
# YOUTUBE_TEST_FILE=youtube-test.mkv

# --- Sala de Cloudflare (solo con "ps4-agent serve --room") ---
# Dirección del WebSocket del agente. Local: ws://localhost:8787/api/agent/ws
# Producción: wss://tu-dominio/api/agent/ws
ROOM_URL=
# Mismo valor que AGENT_TOKEN en el Worker (worker/.dev.vars o "wrangler secret put"). SECRETO.
AGENT_TOKEN=
